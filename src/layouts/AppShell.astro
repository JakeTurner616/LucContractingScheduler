      const renderCalendar = (jobs) => {
        if (!document.querySelector("[data-calendar]")) return;

        const today = new Date();
        const start = new Date(today);
        start.setDate(today.getDate() - today.getDay());
        start.setHours(0, 0, 0, 0);
        const expanded = sessionStorage.getItem(calendarStorageKey) === "true";
        const days = Array.from({ length: expanded ? 35 : 14 }, (_, index) => {
          const day = new Date(start);
          day.setDate(start.getDate() + index);
          return day;
        });

        const jobDateKey = (job) => {
          if (!job.scheduled_start) return "";
          const date = new Date(job.scheduled_start);
          return Number.isNaN(date.getTime()) ? "" : date.toISOString().slice(0, 10);
        };

        const html = `
          <div class="calendar-grid ${expanded ? "expanded" : ""}" data-calendar>
            ${days.map((day) => {
              const key = day.toISOString().slice(0, 10);
              const dayJobs = jobs.filter((job) => jobDateKey(job) === key);
              return `
                <section class="calendar-day">
                  <div class="calendar-date">${escapeHtml(new Intl.DateTimeFormat(undefined, { weekday: "short", month: "short", day: "numeric" }).format(day))}</div>
                  ${dayJobs.map((job) => `
                    <span class="calendar-job">${escapeHtml(job.title)}<span>${escapeHtml(formatDateTime(job.scheduled_start) || "No time")} / ${escapeHtml(job.location || "No location")}</span></span>
