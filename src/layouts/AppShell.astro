      });

      document.addEventListener("change", (event) => {
        const input = event.target instanceof Element ? event.target.closest("[data-work-image-input]") : null;
        if (!(input instanceof HTMLInputElement)) return;
        readWorkImageFile(input).catch((error) => {
          const form = document.querySelector("[data-completion-form]");
          if (form instanceof HTMLFormElement) setStatus(form, error instanceof Error ? error.message : "Could not read image.", "error");
        });
      });

      document.querySelector("[data-signature-dialog]")?.addEventListener("click", (event) => {
        const dialog = event.currentTarget;
        if (event.target === dialog) closeSignatureDocument();
      });

      const captureLocalSession = () => {
        const url = new URL(window.location.href);
        const session = url.searchParams.get("session");
        setText(localAuthStatus, sessionStorage.getItem(sessionStorageKey) ? "Browser session captured" : "No browser session token");
        if (!session) return;

        sessionStorage.setItem(sessionStorageKey, session);
        setText(localAuthStatus, "Browser session captured");
        url.searchParams.delete("session");
        window.history.replaceState({}, "", url.toString());
      };

      populateTimeSelects();
      bindApiForms();
      bindCompletionForm();
      bindSignaturePad();
      captureLocalSession();
      loadSession();
    </script>
  </body>
</html>
