---
import "../styles/global.css";
import { API_ORIGIN } from "../lib/config";

type NavRole = "all" | "employee" | "supervisor";

interface NavItem {
  href: string;
  label: string;
  icon: string;
  role: NavRole;
}

interface Props {
  title: string;
  active: "dashboard" | "schedule" | "jobs" | "workers" | "settings";
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { title, active, eyebrow = "Scheduler", heading, lede } = Astro.props;

const navItems: NavItem[] = [
  { href: "/dashboard", label: "Dashboard", icon: "grid", role: "all" },
  { href: "/schedule", label: "Schedule", icon: "calendar", role: "all" },
  { href: "/jobs", label: "Jobs", icon: "briefcase", role: "supervisor" },
  { href: "/workers", label: "Workers", icon: "users", role: "supervisor" },
  { href: "/settings", label: "Settings", icon: "settings", role: "supervisor" }
];

const icons = {
  grid: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h4A1.5 1.5 0 0 1 11 5.5v4A1.5 1.5 0 0 1 9.5 11h-4A1.5 1.5 0 0 1 4 9.5v-4ZM13 5.5A1.5 1.5 0 0 1 14.5 4h4A1.5 1.5 0 0 1 20 5.5v4a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 13 9.5v-4ZM4 14.5A1.5 1.5 0 0 1 5.5 13h4a1.5 1.5 0 0 1 1.5 1.5v4A1.5 1.5 0 0 1 9.5 20h-4A1.5 1.5 0 0 1 4 18.5v-4ZM13 14.5a1.5 1.5 0 0 1 1.5-1.5h4a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5h-4a1.5 1.5 0 0 1-1.5-1.5v-4Z" stroke="currentColor" stroke-width="2"/></svg>',
  calendar: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3v4M17 3v4M4.5 9h15M6 5h12a2 2 0 0 1 2 2v11.5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  briefcase: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M5.5 8h13A1.5 1.5 0 0 1 20 9.5v8A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-8A1.5 1.5 0 0 1 5.5 8ZM4 13h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 19a4 4 0 0 0-8 0M11 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM20 19a3.5 3.5 0 0 0-4-3.46M16.5 5.3a3 3 0 0 1 0 5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.04.04a2 2 0 0 1-2.83 2.83l-.04-.04A1.7 1.7 0 0 0 15 19.38a1.7 1.7 0 0 0-1 .22 1.7 1.7 0 0 0-.82 1.46V21a2 2 0 0 1-4 0v-.06A1.7 1.7 0 0 0 8.35 19.5a1.7 1.7 0 0 0-1.88.34l-.04.04A2 2 0 1 1 3.6 17.05l.04-.04A1.7 1.7 0 0 0 4 15.1a1.7 1.7 0 0 0-1.46-.82H2.5a2 2 0 0 1 0-4h.06A1.7 1.7 0 0 0 4 9.45a1.7 1.7 0 0 0-.34-1.88l-.04-.04A2 2 0 1 1 6.45 4.7l.04.04A1.7 1.7 0 0 0 8.4 5.1a1.7 1.7 0 0 0 .82-1.46V3.5a2 2 0 0 1 4 0v.06A1.7 1.7 0 0 0 14.05 5a1.7 1.7 0 0 0 1.88-.34l.04-.04A2 2 0 0 1 18.8 7.45l-.04.04A1.7 1.7 0 0 0 18.42 9c.1.35.29.67.56.92.27.25.62.39.98.39H20a2 2 0 0 1 0 4h-.06A1.7 1.7 0 0 0 19.4 15Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | Luc Contracting Scheduler</title>
  </head>
  <body data-api-origin={API_ORIGIN}>
    <div class="app-shell">
      <aside class="sidebar" aria-label="Primary navigation">
        <a class="brand" href="/dashboard">
          <span class="brand-kicker">Luc Contracting</span>
          <span class="brand-name">Scheduler</span>
        </a>
        <nav class="nav-list">
          {navItems.map((item) => (
            <a class="nav-link" href={item.href} data-role={item.role} aria-current={active === item.href.slice(1) ? "page" : undefined}>
              <span class="nav-icon" set:html={icons[item.icon]} />
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="sidebar-footer">
          <div data-session-status>Checking session</div>
          <div data-local-auth-status></div>
        </div>
      </aside>

      <main class="content">
        <header class="topbar">
          <nav class="mobile-nav" aria-label="Primary navigation">
            {navItems.map((item) => (
              <a class="nav-link" href={item.href} data-role={item.role} aria-current={active === item.href.slice(1) ? "page" : undefined}>
                <span class="nav-icon" set:html={icons[item.icon]} />
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
          <div class="session-pill">
            <span class="avatar" data-user-initials>LC</span>
            <span data-user-label>Loading user</span>
          </div>
          <a class="button secondary" href="/login" data-login-action hidden>Sign in</a>
          <form data-logout-form>
            <button class="button secondary" type="submit">Sign out</button>
          </form>
        </header>

        <div class="page">
          <header class="page-header">
            <div>
              <p class="eyebrow">{eyebrow}</p>
              <h1>{heading}</h1>
              {lede && <p class="lede">{lede}</p>}
            </div>
            <slot name="actions" />
          </header>
          <slot />
        </div>
      </main>
    </div>

    <script>
      const apiOrigin = document.body.dataset.apiOrigin;
      const roleItems = Array.from(document.querySelectorAll("[data-role]"));
      const userLabel = document.querySelector("[data-user-label]");
      const userInitials = document.querySelector("[data-user-initials]");
      const sessionStatus = document.querySelector("[data-session-status]");
      const localAuthStatus = document.querySelector("[data-local-auth-status]");
      const logoutForm = document.querySelector("[data-logout-form]");
      const loginAction = document.querySelector("[data-login-action]");
      const sessionStorageKey = "luc_scheduler_session";
      let currentUser = null;
      let isAuthenticated = false;

      const setText = (element, value) => {
        if (element) element.textContent = value;
      };

      const initialsFor = (nameOrEmail) => {
        const clean = String(nameOrEmail || "LC").trim();
        const parts = clean.includes("@") ? clean.split("@")[0].split(/[._-]/) : clean.split(/\s+/);
        return parts.slice(0, 2).map((part) => part[0]?.toUpperCase()).join("") || "LC";
      };

      const applyRole = (role) => {
        roleItems.forEach((item) => {
          const allowedRole = item.getAttribute("data-role");
          const allowed = allowedRole === "all" || allowedRole === role;
          item.toggleAttribute("hidden", !allowed);
        });

        document.querySelectorAll(".requires-supervisor").forEach((node) => {
          node.setAttribute("data-allowed", String(role === "supervisor"));
        });

        document.querySelectorAll(".requires-employee").forEach((node) => {
          node.setAttribute("data-allowed", String(role === "employee"));
        });

        document.querySelectorAll(".role-panel").forEach((node) => {
          node.setAttribute("data-visible", String(node.getAttribute("data-panel-role") === role));
        });
      };

      const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (char) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        })[char]);

      const formatDateTime = (value) => {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return value;
        return new Intl.DateTimeFormat(undefined, {
          weekday: "short",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit"
        }).format(date);
      };

      const apiFetch = async (path, options = {}) => {
        const localSession = sessionStorage.getItem(sessionStorageKey);
        setText(localAuthStatus, localSession ? "Local dev token captured" : "No local dev token");
        const response = await fetch(`${apiOrigin}${path}`, {
          credentials: "include",
          headers: {
            Accept: "application/json",
            ...(localSession ? { Authorization: `Bearer ${localSession}` } : {}),
            ...(options.body ? { "Content-Type": "application/json" } : {}),
            ...(options.headers || {})
          },
          ...options
        });

        const text = await response.text();
        const payload = text ? JSON.parse(text) : {};

        if (!response.ok) {
          const error = new Error(payload.error || `Request failed: ${response.status}`);
          error.status = response.status;
          throw error;
        }

        return payload;
      };

      const formToJson = (form) => {
        const data = new FormData(form);
        const body = {};

        data.forEach((value, key) => {
          if (typeof value === "string" && value.trim() !== "") {
            body[key] = value.trim();
          }
        });

        return body;
      };

      const setStatus = (form, message, kind = "") => {
        const status = form.querySelector("[data-form-status]");
        if (!status) return;
        status.textContent = message;
        status.dataset.kind = kind;
      };

      const setListHtml = (selector, html) => {
        const node = document.querySelector(selector);
        if (node) node.outerHTML = html;
      };

      const renderJobs = (jobs) => {
        if (!document.querySelector("[data-jobs-list]")) return;

        if (!jobs.length) {
          setListHtml("[data-jobs-list]", `<div class="empty-state" data-jobs-list>No jobs have been created yet.</div>`);
          return;
        }

        setListHtml("[data-jobs-list]", `
          <div class="list" data-jobs-list>
            ${jobs.map((job) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(job.title)}</div>
                  <p class="item-meta">${escapeHtml(job.location || "No location")} / ${escapeHtml(job.public_notes || "No public notes")}</p>
                </div>
                <span class="badge">${escapeHtml(job.status)}</span>
              </article>
            `).join("")}
          </div>
        `);
      };

      const renderUsers = (users) => {
        if (!document.querySelector("[data-users-list]")) return;

        if (!users.length) {
          setListHtml("[data-users-list]", `<div class="empty-state" data-users-list>No workers have been added yet.</div>`);
          return;
        }

        setListHtml("[data-users-list]", `
          <div class="list" data-users-list>
            ${users.map((user) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(user.name || user.email)}</div>
                  <p class="item-meta">${escapeHtml(user.email)} / ${escapeHtml(user.role)}</p>
                </div>
                <span class="badge ${user.active === 1 ? "good" : "warn"}">${user.active === 1 ? "Active" : "Inactive"}</span>
              </article>
            `).join("")}
          </div>
        `);
      };

      const renderShifts = (shifts) => {
        const supervisorList = document.querySelector("[data-shifts-list]");
        const employeeList = document.querySelector("[data-employee-shifts-list]");
        const targetSelector = supervisorList ? "[data-shifts-list]" : "[data-employee-shifts-list]";
        const target = supervisorList || employeeList;

        if (!target) return;

        if (!shifts.length) {
          setListHtml(targetSelector, `<div class="empty-state" ${supervisorList ? "data-shifts-list" : "data-employee-shifts-list"}>No shifts are scheduled yet.</div>`);
          return;
        }

        const listHtml = `
          <div class="list" ${supervisorList ? "data-shifts-list" : "data-employee-shifts-list"}>
            ${shifts.map((shift) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(formatDateTime(shift.starts_at))} / ${escapeHtml(shift.job_title)}</div>
                  <p class="item-meta">${escapeHtml(shift.user_name || shift.user_email)} / ${escapeHtml(shift.job_location || "No location")}</p>
                </div>
                <span class="badge">${escapeHtml(shift.status)}</span>
              </article>
            `).join("")}
          </div>
        `;

        setListHtml(targetSelector, listHtml);

        const todayTitle = document.querySelector("[data-today-shift-title]");
        const todayMeta = document.querySelector("[data-today-shift-meta]");
        if (todayTitle && todayMeta) {
          const nextShift = shifts[0];
          todayTitle.textContent = nextShift.job_title || "Scheduled shift";
          todayMeta.textContent = `${formatDateTime(nextShift.starts_at)} / ${nextShift.job_location || "No location"} / ${nextShift.public_notes || "No public notes"}`;
        }
      };

      const populateSelect = (selector, rows, getValue, getLabel, emptyLabel) => {
        const select = document.querySelector(selector);
        if (!(select instanceof HTMLSelectElement)) return;

        if (!rows.length) {
          select.innerHTML = `<option value="">${emptyLabel}</option>`;
          return;
        }

        select.innerHTML = rows.map((row) =>
          `<option value="${escapeHtml(getValue(row))}">${escapeHtml(getLabel(row))}</option>`
        ).join("");
      };

      const loadSchedulerData = async (role) => {
        if (document.querySelector("[data-jobs-list]") || document.querySelector("[data-jobs-select]")) {
          const { jobs } = await apiFetch("/api/jobs");
          renderJobs(jobs || []);
          populateSelect("[data-jobs-select]", jobs || [], (job) => job.id, (job) => job.title, "No jobs available");
        }

        if (role === "supervisor" && (document.querySelector("[data-users-list]") || document.querySelector("[data-workers-select]"))) {
          const { users } = await apiFetch("/api/users");
          renderUsers(users || []);
          populateSelect("[data-workers-select]", (users || []).filter((user) => user.active === 1), (user) => user.id, (user) => user.name || user.email, "No workers available");
        }

        if (document.querySelector("[data-shifts-list]") || document.querySelector("[data-employee-shifts-list]")) {
          const { shifts } = await apiFetch("/api/shifts");
          renderShifts(shifts || []);
        }
      };

      const bindApiForms = () => {
        document.querySelectorAll("[data-api-form]").forEach((form) => {
          form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const resource = form.getAttribute("data-api-form");

            if (!isAuthenticated) {
              setStatus(form, "Please sign in again before saving.", "error");
              return;
            }

            setStatus(form, "Saving...");

            try {
              await apiFetch(`/api/${resource}`, {
                method: "POST",
                body: JSON.stringify(formToJson(form))
              });
              form.reset();
              setStatus(form, "Saved.", "success");
              await loadSchedulerData(currentUser?.role || "employee");
            } catch (error) {
              setStatus(form, error instanceof Error ? error.message : "Save failed.", "error");
            }
          });
        });
      };

      const loadSession = async () => {
        try {
          const payload = await apiFetch("/api/me");
          const user = payload.user ?? payload;
          const role = user.role === "supervisor" ? "supervisor" : "employee";
          const displayName = user.name || user.email || "Luc Contracting";
          currentUser = user;
          isAuthenticated = true;

          applyRole(role);
          if (loginAction) loginAction.hidden = true;
          if (logoutForm) logoutForm.hidden = false;
          setText(userLabel, `${displayName} / ${role}`);
          setText(userInitials, initialsFor(displayName));
          setText(sessionStatus, `Signed in as ${role}`);
          await loadSchedulerData(role);
        } catch (error) {
          currentUser = null;
          isAuthenticated = false;
          applyRole("employee");
          if (loginAction) loginAction.hidden = false;
          if (logoutForm) logoutForm.hidden = true;
          setText(userLabel, "Please sign in");
          setText(userInitials, "LC");
          setText(sessionStatus, error?.status === 401 ? "Not authenticated" : "Waiting for /api/me");
        }
      };

      logoutForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        sessionStorage.removeItem(sessionStorageKey);

        try {
          await fetch(`${apiOrigin}/auth/logout`, {
            method: "POST",
            credentials: "include"
          });
        } finally {
          window.location.href = "/login";
        }
      });

      const captureLocalSession = () => {
        const url = new URL(window.location.href);
        const session = url.searchParams.get("session");
        setText(localAuthStatus, sessionStorage.getItem(sessionStorageKey) ? "Local dev token captured" : "No local dev token");
        if (!session) return;

        sessionStorage.setItem(sessionStorageKey, session);
        setText(localAuthStatus, "Local dev token captured");
        url.searchParams.delete("session");
        window.history.replaceState({}, "", url.toString());
      };

      bindApiForms();
      captureLocalSession();
      loadSession();
    </script>
  </body>
</html>
