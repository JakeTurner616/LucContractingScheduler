---
import "../styles/global.css";
import { API_ORIGIN } from "../lib/config";

type NavRole = "all" | "employee" | "supervisor";

interface NavItem {
  href: string;
  label: string;
  icon: string;
  role: NavRole;
}

interface Props {
  title: string;
  active: "dashboard" | "schedule" | "jobs" | "workers" | "feeds" | "settings";
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { title, active, eyebrow = "Scheduler", heading, lede } = Astro.props;

const navItems: NavItem[] = [
  { href: "/dashboard", label: "Dashboard", icon: "grid", role: "all" },
  { href: "/schedule", label: "Schedule", icon: "calendar", role: "all" },
  { href: "/jobs", label: "Jobs", icon: "briefcase", role: "all" },
  { href: "/workers", label: "Workers", icon: "users", role: "supervisor" },
  { href: "/feeds", label: "Feeds", icon: "calendar", role: "all" },
  { href: "/settings", label: "Settings", icon: "settings", role: "supervisor" }
];

const icons = {
  grid: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h4A1.5 1.5 0 0 1 11 5.5v4A1.5 1.5 0 0 1 9.5 11h-4A1.5 1.5 0 0 1 4 9.5v-4ZM13 5.5A1.5 1.5 0 0 1 14.5 4h4A1.5 1.5 0 0 1 20 5.5v4a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 13 9.5v-4ZM4 14.5A1.5 1.5 0 0 1 5.5 13h4a1.5 1.5 0 0 1 1.5 1.5v4A1.5 1.5 0 0 1 9.5 20h-4A1.5 1.5 0 0 1 4 18.5v-4ZM13 14.5a1.5 1.5 0 0 1 1.5-1.5h4a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5h-4a1.5 1.5 0 0 1-1.5-1.5v-4Z" stroke="currentColor" stroke-width="2"/></svg>',
  calendar: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3v4M17 3v4M4.5 9h15M6 5h12a2 2 0 0 1 2 2v11.5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  briefcase: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M5.5 8h13A1.5 1.5 0 0 1 20 9.5v8A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-8A1.5 1.5 0 0 1 5.5 8ZM4 13h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 19a4 4 0 0 0-8 0M11 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM20 19a3.5 3.5 0 0 0-4-3.46M16.5 5.3a3 3 0 0 1 0 5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.04.04a2 2 0 0 1-2.83 2.83l-.04-.04A1.7 1.7 0 0 0 15 19.38a1.7 1.7 0 0 0-1 .22 1.7 1.7 0 0 0-.82 1.46V21a2 2 0 0 1-4 0v-.06A1.7 1.7 0 0 0 8.35 19.5a1.7 1.7 0 0 0-1.88.34l-.04.04A2 2 0 1 1 3.6 17.05l.04-.04A1.7 1.7 0 0 0 4 15.1a1.7 1.7 0 0 0-1.46-.82H2.5a2 2 0 0 1 0-4h.06A1.7 1.7 0 0 0 4 9.45a1.7 1.7 0 0 0-.34-1.88l-.04-.04A2 2 0 1 1 6.45 4.7l.04.04A1.7 1.7 0 0 0 8.4 5.1a1.7 1.7 0 0 0 .82-1.46V3.5a2 2 0 0 1 4 0v.06A1.7 1.7 0 0 0 14.05 5a1.7 1.7 0 0 0 1.88-.34l.04-.04A2 2 0 0 1 18.8 7.45l-.04.04A1.7 1.7 0 0 0 18.42 9c.1.35.29.67.56.92.27.25.62.39.98.39H20a2 2 0 0 1 0 4h-.06A1.7 1.7 0 0 0 19.4 15Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | Luc Contracting Scheduler</title>
  </head>
  <body data-api-origin={API_ORIGIN}>
    <div class="app-shell">
      <aside class="sidebar" aria-label="Primary navigation">
        <a class="brand" href="/dashboard">
          <span class="brand-kicker">Luc Contracting</span>
          <span class="brand-name">Scheduler</span>
        </a>
        <nav class="nav-list">
          {navItems.map((item) => (
            <a class="nav-link" href={item.href} data-role={item.role} aria-current={active === item.href.slice(1) ? "page" : undefined}>
              <span class="nav-icon" set:html={icons[item.icon]} />
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="sidebar-footer">
          <div data-session-status>Checking session</div>
          <div data-local-auth-status></div>
        </div>
      </aside>

      <main class="content">
        <header class="topbar">
          <nav class="mobile-nav" aria-label="Primary navigation">
            {navItems.map((item) => (
              <a class="nav-link" href={item.href} data-role={item.role} aria-current={active === item.href.slice(1) ? "page" : undefined}>
                <span class="nav-icon" set:html={icons[item.icon]} />
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
          <div class="session-pill">
            <span class="avatar" data-user-initials>LC</span>
            <span data-user-label>Loading user</span>
          </div>
          <a class="button secondary" href="/login" data-login-action hidden>Sign in</a>
        </header>

        <div class="page">
          <header class="page-header">
            <div>
              <p class="eyebrow">{eyebrow}</p>
              <h1>{heading}</h1>
              {lede && <p class="lede">{lede}</p>}
            </div>
            <slot name="actions" />
          </header>
          <slot />
        </div>
      </main>
    </div>

    <script>
      const apiOrigin = document.body.dataset.apiOrigin;
      const roleItems = Array.from(document.querySelectorAll("[data-role]"));
      const userLabel = document.querySelector("[data-user-label]");
      const userInitials = document.querySelector("[data-user-initials]");
      const sessionStatus = document.querySelector("[data-session-status]");
      const localAuthStatus = document.querySelector("[data-local-auth-status]");
      const logoutForm = document.querySelector("[data-logout-form]");
      const loginAction = document.querySelector("[data-login-action]");
      const sessionStorageKey = "luc_scheduler_session";
      const calendarStorageKey = "luc_scheduler_calendar_expanded";
      const spreadsheetCellSafeDataUrlLength = 30000;
      let currentUser = null;
      let isAuthenticated = false;
      let selectedJob = null;
      let signaturePadDirty = false;
      let selectedWorkImageDataUrl = null;

      const setText = (element, value) => {
        if (element) element.textContent = value;
      };

      const initialsFor = (nameOrEmail) => {
        const clean = String(nameOrEmail || "LC").trim();
        const parts = clean.includes("@") ? clean.split("@")[0].split(/[._-]/) : clean.split(/\s+/);
        return parts.slice(0, 2).map((part) => part[0]?.toUpperCase()).join("") || "LC";
      };

      const applyRole = (role) => {
        roleItems.forEach((item) => {
          const allowedRole = item.getAttribute("data-role");
          const allowed = allowedRole === "all" || allowedRole === role;
          item.toggleAttribute("hidden", !allowed);
        });

        document.querySelectorAll(".requires-supervisor").forEach((node) => {
          node.setAttribute("data-allowed", String(role === "supervisor"));
        });

        document.querySelectorAll(".requires-employee").forEach((node) => {
          node.setAttribute("data-allowed", String(role === "employee"));
        });

        document.querySelectorAll(".role-panel").forEach((node) => {
          node.setAttribute("data-visible", String(node.getAttribute("data-panel-role") === role));
        });
      };

      const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (char) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        })[char]);

      const formatDateTime = (value) => {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return value;
        return new Intl.DateTimeFormat(undefined, {
          weekday: "short",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit"
        }).format(date);
      };

      const formatDate = (value) => {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return value;
        return new Intl.DateTimeFormat(undefined, {
          year: "numeric",
          month: "short",
          day: "numeric"
        }).format(date);
      };

      const apiFetch = async (path, options = {}) => {
        const localSession = sessionStorage.getItem(sessionStorageKey);
        setText(localAuthStatus, localSession ? "Browser session captured" : "No browser session token");
        const response = await fetch(`${apiOrigin}${path}`, {
          credentials: "include",
          headers: {
            Accept: "application/json",
            ...(localSession ? { Authorization: `Bearer ${localSession}` } : {}),
            ...(options.body ? { "Content-Type": "application/json" } : {}),
            ...(options.headers || {})
          },
          ...options
        });

        const text = await response.text();
        const payload = text ? JSON.parse(text) : {};

        if (!response.ok) {
          const error = new Error(payload.error || `Request failed: ${response.status}`);
          error.status = response.status;
          throw error;
        }

        return payload;
      };

      const formToJson = (form) => {
        const data = new FormData(form);
        const body = {};

        data.forEach((value, key) => {
          if (typeof value === "string" && value.trim() !== "") {
            body[key] = value.trim();
          }
        });

        form.querySelectorAll("select[multiple]").forEach((select) => {
          body[select.name] = Array.from(select.selectedOptions).map((option) => option.value).filter(Boolean);
        });

        if (form.id === "job-form") {
          const scheduledStart = readJobDateTime(form, "job_date", "start_hour", "start_minute", "start_period");
          const scheduledEnd = readJobDateTime(form, "end_date", "end_hour", "end_minute", "end_period")
            || readJobDateTime(form, "job_date", "end_hour", "end_minute", "end_period");
          delete body.job_date;
          delete body.start_hour;
          delete body.start_minute;
          delete body.start_period;
          delete body.end_date;
          delete body.end_hour;
          delete body.end_minute;
          delete body.end_period;
          body.scheduled_start = scheduledStart || null;
          body.scheduled_end = scheduledEnd || null;
        }

        return body;
      };

      const fieldValue = (form, name) => {
        const field = form.elements[name];
        return typeof field?.value === "string" ? field.value.trim() : "";
      };

      const to24HourTime = (hour, minute, period) => {
        if (!hour || !minute || !period) return "";
        let numericHour = Number(hour);
        if (!Number.isInteger(numericHour) || numericHour < 1 || numericHour > 12) return "";
        if (period === "AM" && numericHour === 12) numericHour = 0;
        if (period === "PM" && numericHour !== 12) numericHour += 12;
        return `${String(numericHour).padStart(2, "0")}:${minute}`;
      };

      const combineDateTimeParts = (date, hour, minute, period) => {
        if (!date) return "";
        const time = to24HourTime(hour, minute, period);
        return time ? `${date}T${time}` : "";
      };

      const readJobDateTime = (form, dateName, hourName, minuteName, periodName) =>
        combineDateTimeParts(
          fieldValue(form, dateName),
          fieldValue(form, hourName),
          fieldValue(form, minuteName),
          fieldValue(form, periodName)
        );

      const splitDateTime = (value) => {
        if (!value) return { date: "", hour: "", minute: "00", period: "AM" };
        const [date = "", rawTime = ""] = String(value).split("T");
        const [rawHour = "09", rawMinute = "00"] = rawTime.split(":");
        const hour24 = Number(rawHour);
        const period = hour24 >= 12 ? "PM" : "AM";
        const hour12 = hour24 % 12 || 12;
        return { date, hour: String(hour12), minute: rawMinute.slice(0, 2), period };
      };

      const setStatus = (form, message, kind = "") => {
        const status = form.querySelector("[data-form-status]");
        if (!status) return;
        status.textContent = message;
        status.dataset.kind = kind;
      };

      const setListHtml = (selector, html) => {
        const node = document.querySelector(selector);
        if (node) node.outerHTML = html;
      };

      const renderJobs = (jobs) => {
        if (!document.querySelector("[data-jobs-list]")) return;

        if (!jobs.length) {
          setListHtml("[data-jobs-list]", `<div class="empty-state" data-jobs-list>No jobs have been created yet.</div>`);
          return;
        }

        setListHtml("[data-jobs-list]", `
          <div class="list" data-jobs-list>
            ${jobs.map((job) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(job.title)}</div>
                  <p class="item-meta">${escapeHtml(formatDateTime(job.scheduled_start) || "No date")} / ${escapeHtml(job.location || "No location")} / ${escapeHtml((job.assigned_user_names || []).join(", ") || "Unassigned")}</p>
                </div>
                ${currentUser?.role === "supervisor" && document.querySelector("#job-form")
                  ? `<div class="button-row"><span class="badge ${job.completion_signed_at ? "good" : ""}">${escapeHtml(job.completion_signed_at ? "Signed" : job.status)}</span><button class="button secondary" type="button" data-edit-job="${escapeHtml(encodeURIComponent(JSON.stringify(job)))}">Edit</button></div>`
                  : `<span class="badge">${escapeHtml(job.status)}</span>`}
              </article>
            `).join("")}
          </div>
        `);
      };

      const documentValue = (value, fallback = "Not recorded") => escapeHtml(value || fallback);

      const setPrintAvailability = (canPrint) => {
        document.querySelectorAll("[data-print-completion-document]").forEach((button) => {
          if (button instanceof HTMLButtonElement) button.disabled = !canPrint;
        });
      };

      const renderCompletionPreview = (job, completion = {}) => {
        const previews = Array.from(document.querySelectorAll("[data-completion-preview], [data-signature-document-preview]"));
        const state = document.querySelector("[data-completion-state]");
        if (!previews.length) return;

        if (!job) {
          previews.forEach((preview) => {
            preview.textContent = "Select a job to prepare its completion document.";
          });
          setPrintAvailability(false);
          if (state) {
            state.textContent = "Unsigned";
            state.className = "badge warn";
          }
          return;
        }

        const workPerformed = completion.work_performed || job.public_notes || "Work completed as scheduled.";
        const signatureName = completion.signature_name || completion.customer_name || "";
        const signedAt = completion.signed_at ? formatDateTime(completion.signed_at) : "";
        const signatureImage = completion.signature_data_url
          ? `<img class="signature-image" src="${escapeHtml(completion.signature_data_url)}" alt="Saved customer signature" />`
          : `<div class="signature-placeholder">Signature pending</div>`;
        const workImage = completion.work_image_data_url
          ? `<section class="document-section document-avoid-break"><span class="document-label">Work image</span><img class="work-image" src="${escapeHtml(completion.work_image_data_url)}" alt="Completed work" /></section>`
          : "";
        const documentHtml = `
          <div class="document-title">
            <div>
              <span class="document-label">Luc Contracting</span>
              <strong>Work Completion Document</strong>
            </div>
            <button class="button secondary document-print-action" type="button" data-print-completion-document disabled>Print</button>
          </div>
          <section class="document-section">
            <div class="document-section-title">Customer Information</div>
            <div class="document-grid customer-grid">
              <div class="document-field"><span class="document-label">Customer</span>${documentValue(completion.customer_name)}</div>
              <div class="document-field"><span class="document-label">Customer email</span>${documentValue(completion.customer_email)}</div>
              <div class="document-field"><span class="document-label">Signed name</span>${documentValue(signatureName)}</div>
              <div class="document-field"><span class="document-label">Signed at</span>${documentValue(signedAt, "Pending signature")}</div>
            </div>
          </section>
          <section class="document-section">
            <div class="document-section-title">Job Information</div>
            <div class="document-grid job-grid">
              <div class="document-field"><span class="document-label">Job</span>${documentValue(job.title)}</div>
              <div class="document-field"><span class="document-label">Status</span>${documentValue(job.status)}</div>
              <div class="document-field"><span class="document-label">Location</span>${documentValue(job.location)}</div>
              <div class="document-field"><span class="document-label">Scheduled</span>${documentValue(formatDateTime(job.scheduled_start))}</div>
              <div class="document-field"><span class="document-label">Completed</span>${documentValue(formatDate(completion.completed_at || completion.signed_at))}</div>
              <div class="document-field"><span class="document-label">Workers</span>${documentValue((job.assigned_user_names || []).join(", "), "Unassigned")}</div>
            </div>
          </section>
          <section class="document-section">
            <span class="document-label">Work performed</span>
            <div class="document-text">${escapeHtml(workPerformed)}</div>
          </section>
          <section class="document-section">
            <span class="document-label">Materials used</span>
            <div class="document-text">${documentValue(completion.materials_used)}</div>
          </section>
          <section class="document-section">
            <span class="document-label">Customer notes</span>
            <div class="document-text">${documentValue(completion.customer_notes)}</div>
          </section>
          ${workImage}
          <section class="document-section document-avoid-break">
            <span class="document-label">Customer acknowledgement</span>
            <div class="document-text">I acknowledge that Luc Contracting has completed the work described in this document at the listed job location. I have had the opportunity to review the completed work, and I confirm that the work has been performed as requested unless otherwise noted in the customer notes section above.</div>
          </section>
          <section class="document-section document-avoid-break">
            <span class="document-label">Saved customer signature</span>
            <div class="document-signature">${signatureImage}</div>
          </section>
        `;
        previews.forEach((preview) => {
          preview.innerHTML = documentHtml;
        });

        if (state) {
          state.textContent = completion.signed_at ? "Signed" : "Unsigned";
          state.className = `badge ${completion.signed_at ? "good" : "warn"}`;
        }
        setPrintAvailability(Boolean(completion.signed_at && completion.signature_data_url));
      };

      const clearSignaturePad = () => {
        const canvas = document.querySelector("[data-signature-pad]");
        if (!(canvas instanceof HTMLCanvasElement)) return;
        const context = canvas.getContext("2d");
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.fillStyle = "#ffffff";
        context.fillRect(0, 0, canvas.width, canvas.height);
        signaturePadDirty = false;
      };

      const loadCompletionDocument = async (job) => {
        const panel = document.querySelector("[data-completion-panel]");
        const form = document.querySelector("[data-completion-form]");
        if (!(form instanceof HTMLFormElement) || !panel || !job?.id) return;

        selectedJob = job;
        panel.hidden = false;
        setStatus(form, "Loading completion document...");
        clearSignaturePad();
        selectedWorkImageDataUrl = null;
        const imageInput = form.querySelector("[data-work-image-input]");
        if (imageInput instanceof HTMLInputElement) imageInput.value = "";

        try {
          const { completion } = await apiFetch(`/api/jobs/${encodeURIComponent(job.id)}/completion`);
          selectedWorkImageDataUrl = completion?.work_image_data_url || null;
          form.elements.customer_name.value = completion?.customer_name || job.customer_name || "";
          form.elements.customer_email.value = completion?.customer_email || job.customer_email || "";
          form.elements.work_performed.value = completion?.work_performed || job.public_notes || "Work completed as scheduled.";
          form.elements.materials_used.value = completion?.materials_used || "";
          form.elements.customer_notes.value = completion?.customer_notes || "";
          renderCompletionPreview(job, completion || {});
          setStatus(form, completion?.signed_at ? "Signed completion document on file." : "Ready for customer signature.", completion?.signed_at ? "success" : "");
        } catch (error) {
          renderCompletionPreview(job, {});
          setStatus(form, error instanceof Error ? error.message : "Could not load completion document.", "error");
        }
      };

      const fillJobForm = (job) => {
        const form = document.querySelector("#job-form");
        if (!(form instanceof HTMLFormElement)) return;

        form.querySelector("[data-job-id]").value = job.id || "";
        form.elements.title.value = job.title || "";
        form.elements.customer_name.value = job.customer_name || "";
        form.elements.customer_email.value = job.customer_email || "";
        form.elements.location.value = job.location || "";
        const start = splitDateTime(job.scheduled_start);
        const end = splitDateTime(job.scheduled_end);
        form.elements.job_date.value = start.date;
        form.elements.start_hour.value = start.hour;
        form.elements.start_minute.value = start.minute;
        form.elements.start_period.value = start.period;
        form.elements.end_date.value = end.date;
        form.elements.end_hour.value = end.hour;
        form.elements.end_minute.value = end.minute;
        form.elements.end_period.value = end.period;
        form.elements.status.value = job.status || "scheduled";
        form.elements.public_notes.value = job.public_notes || "";
        form.elements.internal_notes.value = job.internal_notes || "";

        const assigned = new Set(job.assigned_user_ids || []);
        Array.from(form.elements.assigned_user_ids?.options || []).forEach((option) => {
          option.selected = assigned.has(option.value);
        });

        form.scrollIntoView({ behavior: "smooth", block: "start" });
        loadCompletionDocument(job);
      };

      const renderConsultations = (consultations) => {
        if (!document.querySelector("[data-consultations-list]")) return;

        if (!consultations.length) {
          setListHtml("[data-consultations-list]", `<div class="empty-state" data-consultations-list>No consultation requests found.</div>`);
          return;
        }

        setListHtml("[data-consultations-list]", `
          <div class="list" data-consultations-list>
            ${consultations.map((consult) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(consult.name)} / ${escapeHtml(consult.service_type || "Consultation")}</div>
                  <p class="item-meta">${escapeHtml(consult.preferred_date || "No date")} ${escapeHtml(consult.preferred_time || "")} / ${escapeHtml(consult.address || "No address")} / ${escapeHtml(consult.email)}</p>
                </div>
                <span class="badge">${escapeHtml(consult.status)}</span>
              </article>
            `).join("")}
          </div>
        `);
      };

      const renderUsers = (users) => {
        if (!document.querySelector("[data-users-list]")) return;

        if (!users.length) {
          setListHtml("[data-users-list]", `<div class="empty-state" data-users-list>No workers have been added yet.</div>`);
          return;
        }

        setListHtml("[data-users-list]", `
          <div class="list" data-users-list>
            ${users.map((user) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(user.name || user.email)}</div>
                  <p class="item-meta">${escapeHtml(user.email)} / ${escapeHtml(user.role)} / ${escapeHtml(user.last_login_at ? `Last login ${formatDateTime(user.last_login_at)}` : "No login recorded")}</p>
                </div>
                <div class="button-row">
