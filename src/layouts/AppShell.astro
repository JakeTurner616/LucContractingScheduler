      const readWorkImageFile = async (input) => {
        const form = document.querySelector("[data-completion-form]");
        if (!(form instanceof HTMLFormElement)) return;

        const file = input.files?.[0];
        if (!file) {
          selectedWorkImageDataUrl = null;
          const data = formToJson(form);
          data.work_image_data_url = selectedWorkImageDataUrl;
          renderCompletionPreview(selectedJob, data);
          return;
        }

        if (!["image/png", "image/jpeg", "image/webp"].includes(file.type) || file.size > 6000000) {
          input.value = "";
          selectedWorkImageDataUrl = null;
          setStatus(form, "Use a PNG, JPEG, or WebP image under 6 MB.", "error");
          return;
        }

        setStatus(form, "Compressing work image...");
        selectedWorkImageDataUrl = await compressWorkImage(file);

        const data = formToJson(form);
        data.work_image_data_url = selectedWorkImageDataUrl;
        renderCompletionPreview(selectedJob, data);
        setStatus(form, "Work image attached and compressed.");
      };

      const dataUrlFromCanvas = (sourceCanvas, maxLength, initialQuality = 0.72) => {
        let canvas = sourceCanvas;
        let quality = initialQuality;
        let dataUrl = canvas.toDataURL("image/jpeg", quality);

        while (dataUrl.length > maxLength && quality > 0.36) {
          quality -= 0.08;
          dataUrl = canvas.toDataURL("image/jpeg", quality);
        }

        while (dataUrl.length > maxLength && canvas.width > 160 && canvas.height > 120) {
          const nextCanvas = document.createElement("canvas");
          nextCanvas.width = Math.max(160, Math.round(canvas.width * 0.82));
          nextCanvas.height = Math.max(120, Math.round(canvas.height * 0.82));
          const context = nextCanvas.getContext("2d");
          context.fillStyle = "#ffffff";
          context.fillRect(0, 0, nextCanvas.width, nextCanvas.height);
          context.drawImage(canvas, 0, 0, nextCanvas.width, nextCanvas.height);
          canvas = nextCanvas;
          quality = 0.52;
          dataUrl = canvas.toDataURL("image/jpeg", quality);
        }

        return dataUrl;
      };

      const compressSignatureCanvas = (sourceCanvas) => {
        const canvas = document.createElement("canvas");
        canvas.width = 560;
        canvas.height = 146;
        const context = canvas.getContext("2d");
        context.fillStyle = "#ffffff";
        context.fillRect(0, 0, canvas.width, canvas.height);
        context.drawImage(sourceCanvas, 0, 0, canvas.width, canvas.height);
        return dataUrlFromCanvas(canvas, spreadsheetCellSafeDataUrlLength, 0.68);
      };

      const compressWorkImage = (file) => new Promise((resolve, reject) => {
        const image = new Image();
        const reader = new FileReader();

        reader.addEventListener("load", () => {
          image.src = String(reader.result || "");
        });
        reader.addEventListener("error", () => reject(new Error("Could not read image.")));
        image.addEventListener("error", () => reject(new Error("Could not load image.")));
        image.addEventListener("load", () => {
          const maxWidth = 460;
          const maxHeight = 340;
          const scale = Math.min(1, maxWidth / image.naturalWidth, maxHeight / image.naturalHeight);
          const width = Math.max(1, Math.round(image.naturalWidth * scale));
          const height = Math.max(1, Math.round(image.naturalHeight * scale));
          const canvas = document.createElement("canvas");
          canvas.width = width;
          canvas.height = height;
          const context = canvas.getContext("2d");
          context.fillStyle = "#ffffff";
          context.fillRect(0, 0, width, height);
          context.drawImage(image, 0, 0, width, height);
          const dataUrl = dataUrlFromCanvas(canvas, spreadsheetCellSafeDataUrlLength, 0.64);

          if (dataUrl.length > spreadsheetCellSafeDataUrlLength) {
            reject(new Error("Compressed image is still too large for spreadsheet export. Try a simpler or smaller photo."));
            return;
          }

          resolve(dataUrl);
        });

        reader.readAsDataURL(file);
      });

      const bindSignaturePad = () => {
        const canvas = document.querySelector("[data-signature-pad]");
        if (!(canvas instanceof HTMLCanvasElement)) return;

        const context = canvas.getContext("2d");
        context.lineCap = "round";
        context.lineJoin = "round";
        context.lineWidth = 3;
        context.strokeStyle = "#20251f";
        clearSignaturePad();

        let drawing = false;
        const pointFor = (event) => {
          const rect = canvas.getBoundingClientRect();
          return {
            x: ((event.clientX - rect.left) / rect.width) * canvas.width,
            y: ((event.clientY - rect.top) / rect.height) * canvas.height
          };
        };

        canvas.addEventListener("pointerdown", (event) => {
          drawing = true;
          signaturePadDirty = true;
          canvas.setPointerCapture(event.pointerId);
          const point = pointFor(event);
          context.beginPath();
          context.moveTo(point.x, point.y);
        });

        canvas.addEventListener("pointermove", (event) => {
          if (!drawing) return;
          const point = pointFor(event);
          context.lineTo(point.x, point.y);
          context.stroke();
        });

        const finish = () => {
          drawing = false;
        };
        canvas.addEventListener("pointerup", finish);
        canvas.addEventListener("pointercancel", finish);
      };

      const populateTimeSelects = () => {
