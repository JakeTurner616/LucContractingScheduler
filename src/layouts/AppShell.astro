---
import "../styles/global.css";
import { API_ORIGIN } from "../lib/config";

type NavRole = "all" | "employee" | "supervisor";

interface NavItem {
  href: string;
  label: string;
  icon: string;
  role: NavRole;
}

interface Props {
  title: string;
  active: "dashboard" | "schedule" | "jobs" | "workers" | "feeds" | "settings";
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { title, active, eyebrow = "Scheduler", heading, lede } = Astro.props;

const navItems: NavItem[] = [
  { href: "/dashboard", label: "Dashboard", icon: "grid", role: "all" },
  { href: "/schedule", label: "Schedule", icon: "calendar", role: "all" },
  { href: "/jobs", label: "Jobs", icon: "briefcase", role: "all" },
  { href: "/workers", label: "Workers", icon: "users", role: "supervisor" },
  { href: "/feeds", label: "Feeds", icon: "calendar", role: "all" },
  { href: "/settings", label: "Settings", icon: "settings", role: "supervisor" }
];

const icons = {
  grid: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h4A1.5 1.5 0 0 1 11 5.5v4A1.5 1.5 0 0 1 9.5 11h-4A1.5 1.5 0 0 1 4 9.5v-4ZM13 5.5A1.5 1.5 0 0 1 14.5 4h4A1.5 1.5 0 0 1 20 5.5v4a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 13 9.5v-4ZM4 14.5A1.5 1.5 0 0 1 5.5 13h4a1.5 1.5 0 0 1 1.5 1.5v4A1.5 1.5 0 0 1 9.5 20h-4A1.5 1.5 0 0 1 4 18.5v-4ZM13 14.5a1.5 1.5 0 0 1 1.5-1.5h4a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5h-4a1.5 1.5 0 0 1-1.5-1.5v-4Z" stroke="currentColor" stroke-width="2"/></svg>',
  calendar: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3v4M17 3v4M4.5 9h15M6 5h12a2 2 0 0 1 2 2v11.5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  briefcase: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M5.5 8h13A1.5 1.5 0 0 1 20 9.5v8A2.5 2.5 0 0 1 17.5 20h-11A2.5 2.5 0 0 1 4 17.5v-8A1.5 1.5 0 0 1 5.5 8ZM4 13h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  users: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 19a4 4 0 0 0-8 0M11 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM20 19a3.5 3.5 0 0 0-4-3.46M16.5 5.3a3 3 0 0 1 0 5.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" stroke="currentColor" stroke-width="2"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.04.04a2 2 0 0 1-2.83 2.83l-.04-.04A1.7 1.7 0 0 0 15 19.38a1.7 1.7 0 0 0-1 .22 1.7 1.7 0 0 0-.82 1.46V21a2 2 0 0 1-4 0v-.06A1.7 1.7 0 0 0 8.35 19.5a1.7 1.7 0 0 0-1.88.34l-.04.04A2 2 0 1 1 3.6 17.05l.04-.04A1.7 1.7 0 0 0 4 15.1a1.7 1.7 0 0 0-1.46-.82H2.5a2 2 0 0 1 0-4h.06A1.7 1.7 0 0 0 4 9.45a1.7 1.7 0 0 0-.34-1.88l-.04-.04A2 2 0 1 1 6.45 4.7l.04.04A1.7 1.7 0 0 0 8.4 5.1a1.7 1.7 0 0 0 .82-1.46V3.5a2 2 0 0 1 4 0v.06A1.7 1.7 0 0 0 14.05 5a1.7 1.7 0 0 0 1.88-.34l.04-.04A2 2 0 0 1 18.8 7.45l-.04.04A1.7 1.7 0 0 0 18.42 9c.1.35.29.67.56.92.27.25.62.39.98.39H20a2 2 0 0 1 0 4h-.06A1.7 1.7 0 0 0 19.4 15Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | Luc Contracting Scheduler</title>
  </head>
  <body data-api-origin={API_ORIGIN}>
    <div class="app-shell">
      <aside class="sidebar" aria-label="Primary navigation">
        <a class="brand" href="/dashboard">
          <span class="brand-kicker">Luc Contracting</span>
          <span class="brand-name">Scheduler</span>
        </a>
        <nav class="nav-list">
          {navItems.map((item) => (
            <a class="nav-link" href={item.href} data-role={item.role} aria-current={active === item.href.slice(1) ? "page" : undefined}>
              <span class="nav-icon" set:html={icons[item.icon]} />
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="sidebar-footer">
          <div data-session-status>Checking session</div>
          <div data-local-auth-status></div>
        </div>
      </aside>

      <main class="content">
        <header class="topbar">
          <nav class="mobile-nav" aria-label="Primary navigation">
            {navItems.map((item) => (
              <a class="nav-link" href={item.href} data-role={item.role} aria-current={active === item.href.slice(1) ? "page" : undefined}>
                <span class="nav-icon" set:html={icons[item.icon]} />
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
          <div class="session-pill">
            <span class="avatar" data-user-initials>LC</span>
            <span data-user-label>Loading user</span>
          </div>
          <a class="button secondary" href="/login" data-login-action hidden>Sign in</a>
        </header>

        <div class="page">
          <header class="page-header">
            <div>
              <p class="eyebrow">{eyebrow}</p>
              <h1>{heading}</h1>
              {lede && <p class="lede">{lede}</p>}
            </div>
            <slot name="actions" />
          </header>
          <slot />
        </div>
      </main>
    </div>

    <script>
      const apiOrigin = document.body.dataset.apiOrigin;
      const roleItems = Array.from(document.querySelectorAll("[data-role]"));
      const userLabel = document.querySelector("[data-user-label]");
      const userInitials = document.querySelector("[data-user-initials]");
      const sessionStatus = document.querySelector("[data-session-status]");
      const localAuthStatus = document.querySelector("[data-local-auth-status]");
      const logoutForm = document.querySelector("[data-logout-form]");
      const loginAction = document.querySelector("[data-login-action]");
      const sessionStorageKey = "luc_scheduler_session";
      const calendarStorageKey = "luc_scheduler_calendar_expanded";
      let currentUser = null;
      let isAuthenticated = false;

      const setText = (element, value) => {
        if (element) element.textContent = value;
      };

      const initialsFor = (nameOrEmail) => {
        const clean = String(nameOrEmail || "LC").trim();
        const parts = clean.includes("@") ? clean.split("@")[0].split(/[._-]/) : clean.split(/\s+/);
        return parts.slice(0, 2).map((part) => part[0]?.toUpperCase()).join("") || "LC";
      };

      const applyRole = (role) => {
        roleItems.forEach((item) => {
          const allowedRole = item.getAttribute("data-role");
          const allowed = allowedRole === "all" || allowedRole === role;
          item.toggleAttribute("hidden", !allowed);
        });

        document.querySelectorAll(".requires-supervisor").forEach((node) => {
          node.setAttribute("data-allowed", String(role === "supervisor"));
        });

        document.querySelectorAll(".requires-employee").forEach((node) => {
          node.setAttribute("data-allowed", String(role === "employee"));
        });

        document.querySelectorAll(".role-panel").forEach((node) => {
          node.setAttribute("data-visible", String(node.getAttribute("data-panel-role") === role));
        });
      };

      const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (char) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;"
        })[char]);

      const formatDateTime = (value) => {
        if (!value) return "";
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return value;
        return new Intl.DateTimeFormat(undefined, {
          weekday: "short",
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit"
        }).format(date);
      };

      const apiFetch = async (path, options = {}) => {
        const localSession = sessionStorage.getItem(sessionStorageKey);
        setText(localAuthStatus, localSession ? "Browser session captured" : "No browser session token");
        const response = await fetch(`${apiOrigin}${path}`, {
          credentials: "include",
          headers: {
            Accept: "application/json",
            ...(localSession ? { Authorization: `Bearer ${localSession}` } : {}),
            ...(options.body ? { "Content-Type": "application/json" } : {}),
            ...(options.headers || {})
          },
          ...options
        });

        const text = await response.text();
        const payload = text ? JSON.parse(text) : {};

        if (!response.ok) {
          const error = new Error(payload.error || `Request failed: ${response.status}`);
          error.status = response.status;
          throw error;
        }

        return payload;
      };

      const formToJson = (form) => {
        const data = new FormData(form);
        const body = {};

        data.forEach((value, key) => {
          if (typeof value === "string" && value.trim() !== "") {
            body[key] = value.trim();
          }
        });

        form.querySelectorAll("select[multiple]").forEach((select) => {
          body[select.name] = Array.from(select.selectedOptions).map((option) => option.value).filter(Boolean);
        });

        if (form.id === "job-form") {
          const scheduledStart = combineDateTimeParts(body.job_date, body.start_hour, body.start_minute, body.start_period);
          const scheduledEnd = combineDateTimeParts(body.end_date || body.job_date, body.end_hour, body.end_minute, body.end_period);
          delete body.job_date;
          delete body.start_hour;
          delete body.start_minute;
          delete body.start_period;
          delete body.end_date;
          delete body.end_hour;
          delete body.end_minute;
          delete body.end_period;
          if (scheduledStart) body.scheduled_start = scheduledStart;
          if (scheduledEnd) body.scheduled_end = scheduledEnd;
        }

        return body;
      };

      const to24HourTime = (hour, minute, period) => {
        if (!hour || !minute || !period) return "";
        let numericHour = Number(hour);
        if (!Number.isInteger(numericHour) || numericHour < 1 || numericHour > 12) return "";
        if (period === "AM" && numericHour === 12) numericHour = 0;
        if (period === "PM" && numericHour !== 12) numericHour += 12;
        return `${String(numericHour).padStart(2, "0")}:${minute}`;
      };

      const combineDateTimeParts = (date, hour, minute, period) => {
        if (!date) return "";
        const time = to24HourTime(hour, minute, period);
        return time ? `${date}T${time}` : "";
      };

      const splitDateTime = (value) => {
        if (!value) return { date: "", hour: "", minute: "00", period: "AM" };
        const [date = "", rawTime = ""] = String(value).split("T");
        const [rawHour = "09", rawMinute = "00"] = rawTime.split(":");
        const hour24 = Number(rawHour);
        const period = hour24 >= 12 ? "PM" : "AM";
        const hour12 = hour24 % 12 || 12;
        return { date, hour: String(hour12), minute: rawMinute.slice(0, 2), period };
      };

      const setStatus = (form, message, kind = "") => {
        const status = form.querySelector("[data-form-status]");
        if (!status) return;
        status.textContent = message;
        status.dataset.kind = kind;
      };

      const setListHtml = (selector, html) => {
        const node = document.querySelector(selector);
        if (node) node.outerHTML = html;
      };

      const renderJobs = (jobs) => {
        if (!document.querySelector("[data-jobs-list]")) return;

        if (!jobs.length) {
          setListHtml("[data-jobs-list]", `<div class="empty-state" data-jobs-list>No jobs have been created yet.</div>`);
          return;
        }

        setListHtml("[data-jobs-list]", `
          <div class="list" data-jobs-list>
            ${jobs.map((job) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(job.title)}</div>
                  <p class="item-meta">${escapeHtml(formatDateTime(job.scheduled_start) || "No date")} / ${escapeHtml(job.location || "No location")} / ${escapeHtml((job.assigned_user_names || []).join(", ") || "Unassigned")}</p>
                </div>
                ${currentUser?.role === "supervisor" && document.querySelector("#job-form")
                  ? `<button class="button secondary" type="button" data-edit-job="${escapeHtml(encodeURIComponent(JSON.stringify(job)))}">Edit</button>`
                  : `<span class="badge">${escapeHtml(job.status)}</span>`}
              </article>
            `).join("")}
          </div>
        `);
      };

      const fillJobForm = (job) => {
        const form = document.querySelector("#job-form");
        if (!(form instanceof HTMLFormElement)) return;

        form.querySelector("[data-job-id]").value = job.id || "";
        form.elements.title.value = job.title || "";
        form.elements.location.value = job.location || "";
        const start = splitDateTime(job.scheduled_start);
        const end = splitDateTime(job.scheduled_end);
        form.elements.job_date.value = start.date;
        form.elements.start_hour.value = start.hour;
        form.elements.start_minute.value = start.minute;
        form.elements.start_period.value = start.period;
        form.elements.end_date.value = end.date;
        form.elements.end_hour.value = end.hour;
        form.elements.end_minute.value = end.minute;
        form.elements.end_period.value = end.period;
        form.elements.status.value = job.status || "scheduled";
        form.elements.public_notes.value = job.public_notes || "";
        form.elements.internal_notes.value = job.internal_notes || "";

        const assigned = new Set(job.assigned_user_ids || []);
        Array.from(form.elements.assigned_user_ids?.options || []).forEach((option) => {
          option.selected = assigned.has(option.value);
        });

        form.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      const renderConsultations = (consultations) => {
        if (!document.querySelector("[data-consultations-list]")) return;

        if (!consultations.length) {
          setListHtml("[data-consultations-list]", `<div class="empty-state" data-consultations-list>No consultation requests found.</div>`);
          return;
        }

        setListHtml("[data-consultations-list]", `
          <div class="list" data-consultations-list>
            ${consultations.map((consult) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(consult.name)} / ${escapeHtml(consult.service_type || "Consultation")}</div>
                  <p class="item-meta">${escapeHtml(consult.preferred_date || "No date")} ${escapeHtml(consult.preferred_time || "")} / ${escapeHtml(consult.address || "No address")} / ${escapeHtml(consult.email)}</p>
                </div>
                <span class="badge">${escapeHtml(consult.status)}</span>
              </article>
            `).join("")}
          </div>
        `);
      };

      const renderUsers = (users) => {
        if (!document.querySelector("[data-users-list]")) return;

        if (!users.length) {
          setListHtml("[data-users-list]", `<div class="empty-state" data-users-list>No workers have been added yet.</div>`);
          return;
        }

        setListHtml("[data-users-list]", `
          <div class="list" data-users-list>
            ${users.map((user) => `
              <article class="list-item">
                <div>
                  <div class="item-title">${escapeHtml(user.name || user.email)}</div>
                  <p class="item-meta">${escapeHtml(user.email)} / ${escapeHtml(user.role)}</p>
                </div>
                <span class="badge ${user.active === 1 ? "good" : "warn"}">${user.active === 1 ? "Active" : "Inactive"}</span>
              </article>
            `).join("")}
          </div>
        `);
      };

      const renderCalendar = (jobs) => {
        if (!document.querySelector("[data-calendar]")) return;

        const today = new Date();
        const start = new Date(today);
        start.setDate(today.getDate() - today.getDay());
        start.setHours(0, 0, 0, 0);
        const expanded = sessionStorage.getItem(calendarStorageKey) === "true";
        const days = Array.from({ length: expanded ? 35 : 14 }, (_, index) => {
          const day = new Date(start);
          day.setDate(start.getDate() + index);
          return day;
        });

        const jobDateKey = (job) => {
          if (!job.scheduled_start) return "";
          const date = new Date(job.scheduled_start);
          return Number.isNaN(date.getTime()) ? "" : date.toISOString().slice(0, 10);
        };

        const html = `
          <div class="calendar-grid ${expanded ? "expanded" : ""}" data-calendar>
            ${days.map((day) => {
              const key = day.toISOString().slice(0, 10);
              const dayJobs = jobs.filter((job) => jobDateKey(job) === key);
              return `
                <section class="calendar-day">
                  <div class="calendar-date">${escapeHtml(new Intl.DateTimeFormat(undefined, { weekday: "short", month: "short", day: "numeric" }).format(day))}</div>
                  ${dayJobs.map((job) => `
                    <span class="calendar-job">${escapeHtml(job.title)}<span>${escapeHtml(formatDateTime(job.scheduled_start) || "No time")} / ${escapeHtml(job.location || "No location")}</span></span>
                  `).join("")}
                </section>
              `;
            }).join("")}
          </div>
        `;

        setListHtml("[data-calendar]", html);
      };

      const renderFeeds = (feeds) => {
        if (!document.querySelector("[data-feeds-list]")) return;
        if (!feeds.length) {
          setListHtml("[data-feeds-list]", `<div class="empty-state" data-feeds-list>No feeds have been generated yet.</div>`);
          return;
        }
        setListHtml("[data-feeds-list]", `
          <div class="list" data-feeds-list>
            ${feeds.map((feed) => {
              const feedUrl = `${apiOrigin}/ics/${encodeURIComponent(feed.token)}`;
              return `
                <article class="list-item">
                  <div>
                    <div class="item-title">${escapeHtml(feed.feed_type === "supervisor_all" ? "Supervisor all" : feed.user_name || feed.user_email || "Worker feed")}</div>
                    <p class="item-meta">${escapeHtml(feedUrl)}</p>
                  </div>
                  <div class="button-row">
                    <a class="button secondary" href="${escapeHtml(feedUrl)}" target="_blank" rel="noreferrer">Open</a>
                    <button class="button secondary" type="button" data-copy-url="${escapeHtml(feedUrl)}">Copy</button>
                  </div>
                </article>
              `;
            }).join("")}
          </div>
        `);
      };

      const populateSelect = (selector, rows, getValue, getLabel, emptyLabel) => {
        const select = document.querySelector(selector);
        if (!(select instanceof HTMLSelectElement)) return;

        if (!rows.length) {
          select.innerHTML = `<option value="">${emptyLabel}</option>`;
          return;
        }

        select.innerHTML = rows.map((row) =>
          `<option value="${escapeHtml(getValue(row))}">${escapeHtml(getLabel(row))}</option>`
        ).join("");
      };

      const loadSchedulerData = async (role) => {
        if (document.querySelector("[data-jobs-list]") || document.querySelector("[data-jobs-select]")) {
          const { jobs } = await apiFetch("/api/jobs");
          renderJobs(jobs || []);
          populateSelect("[data-jobs-select]", jobs || [], (job) => job.id, (job) => job.title, "No jobs available");
        }

        if (role === "supervisor" && (document.querySelector("[data-users-list]") || document.querySelector("[data-workers-select]"))) {
          const { users } = await apiFetch("/api/users");
          renderUsers(users || []);
          populateSelect("[data-workers-select]", (users || []).filter((user) => user.active === 1), (user) => user.id, (user) => user.name || user.email, "No workers available");
        }

        if (document.querySelector("[data-calendar]")) {
          const { jobs } = await apiFetch("/api/jobs");
          renderCalendar(jobs || []);
        }

        if (role === "supervisor" && document.querySelector("[data-consultations-list]")) {
          const { consultations } = await apiFetch("/api/consultations");
          renderConsultations(consultations || []);
        }

        if (document.querySelector("[data-feeds-list]")) {
          const { feeds } = await apiFetch("/api/feeds");
          renderFeeds(feeds || []);
        }
      };

      const bindApiForms = () => {
        document.querySelectorAll("[data-api-form]").forEach((form) => {
          form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const resource = form.getAttribute("data-api-form");

            if (!isAuthenticated) {
              setStatus(form, "Please sign in again before saving.", "error");
              return;
            }

            setStatus(form, "Saving...");

            try {
              const body = formToJson(form);
              const jobId = resource === "jobs" ? body.id : "";
              delete body.id;

              await apiFetch(jobId ? `/api/${resource}/${encodeURIComponent(jobId)}` : `/api/${resource}`, {
                method: jobId ? "PUT" : "POST",
                body: JSON.stringify(body)
              });
              form.reset();
              form.querySelector("[data-job-id]")?.setAttribute("value", "");
              setStatus(form, "Saved.", "success");
              await loadSchedulerData(currentUser?.role || "employee");
            } catch (error) {
              setStatus(form, error instanceof Error ? error.message : "Save failed.", "error");
            }
          });
        });
      };

      const populateTimeSelects = () => {
        document.querySelectorAll("[data-hour-select]").forEach((select) => {
          if (!(select instanceof HTMLSelectElement) || select.dataset.loaded === "true") return;
          const options = select.name === "end_hour" ? ['<option value="">No end time</option>'] : [];
          for (let hour = 1; hour <= 12; hour += 1) {
            const selected = select.name === "start_hour" && hour === 9 ? " selected" : "";
            options.push(`<option value="${hour}"${selected}>${hour}</option>`);
          }
          select.innerHTML = options.join("");
          if (select.name === "start_hour") select.value = "9";
          if (select.name === "end_hour") select.value = "";
          select.dataset.loaded = "true";
        });

        document.querySelectorAll("[data-minute-select]").forEach((select) => {
          if (!(select instanceof HTMLSelectElement) || select.dataset.loaded === "true") return;
          select.innerHTML = ["00", "15", "30", "45"].map((minute) => `<option value="${minute}">${minute}</option>`).join("");
          select.value = "00";
          select.dataset.loaded = "true";
        });

        document.querySelectorAll("[data-period-select]").forEach((select) => {
          if (!(select instanceof HTMLSelectElement) || select.dataset.loaded === "true") return;
          select.innerHTML = ['<option value="AM">AM</option>', '<option value="PM">PM</option>'].join("");
          select.value = "AM";
          select.dataset.loaded = "true";
        });
      };

      const loadSession = async () => {
        try {
          const payload = await apiFetch("/api/me");
          const user = payload.user ?? payload;
          const role = user.role === "supervisor" ? "supervisor" : "employee";
          const displayName = user.name || user.email || "Luc Contracting";
          currentUser = user;
          isAuthenticated = true;

          applyRole(role);
          if (loginAction) loginAction.hidden = true;
          if (logoutForm) logoutForm.hidden = false;
          setText(userLabel, `${displayName} / ${role}`);
          setText(userInitials, initialsFor(displayName));
          setText(sessionStatus, `Signed in as ${role}`);
          await loadSchedulerData(role);
        } catch (error) {
          currentUser = null;
          isAuthenticated = false;
          if (error?.status === 401) {
            sessionStorage.removeItem(sessionStorageKey);
          }
          applyRole("employee");
          if (loginAction) loginAction.hidden = false;
          if (logoutForm) logoutForm.hidden = true;
          setText(userLabel, "Please sign in");
          setText(userInitials, "LC");
          setText(sessionStatus, error?.status === 401 ? "Not authenticated" : "Waiting for /api/me");

          if (error?.status === 401) {
            const loginUrl = new URL("/login", window.location.origin);
            loginUrl.searchParams.set("return_to", `${window.location.pathname}${window.location.search}${window.location.hash}`);
            window.location.replace(loginUrl.toString());
          }
        }
      };

      logoutForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        sessionStorage.removeItem(sessionStorageKey);

        try {
          await fetch(`${apiOrigin}/auth/logout`, {
            method: "POST",
            credentials: "include"
          });
        } finally {
          window.location.href = "/login";
        }
      });

      document.addEventListener("click", (event) => {
        const button = event.target instanceof Element ? event.target.closest("[data-edit-job]") : null;
        if (!(button instanceof HTMLButtonElement)) return;

        try {
          fillJobForm(JSON.parse(decodeURIComponent(button.dataset.editJob || "")));
        } catch {
          // Ignore malformed edit payloads.
        }
      });

      document.addEventListener("click", async (event) => {
        const button = event.target instanceof Element ? event.target.closest("[data-copy-url]") : null;
        if (!(button instanceof HTMLButtonElement)) return;

        try {
          await navigator.clipboard.writeText(button.dataset.copyUrl || "");
          button.textContent = "Copied";
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1600);
        } catch {
          button.textContent = "Copy failed";
        }
      });

      document.addEventListener("click", async (event) => {
        const button = event.target instanceof Element ? event.target.closest("[data-calendar-toggle]") : null;
        if (!(button instanceof HTMLButtonElement)) return;

        const next = sessionStorage.getItem(calendarStorageKey) !== "true";
        sessionStorage.setItem(calendarStorageKey, String(next));
        button.textContent = next ? "Collapse calendar" : "Expand calendar";
        await loadSchedulerData(currentUser?.role || "employee");
      });

      const captureLocalSession = () => {
        const url = new URL(window.location.href);
        const session = url.searchParams.get("session");
        setText(localAuthStatus, sessionStorage.getItem(sessionStorageKey) ? "Browser session captured" : "No browser session token");
        if (!session) return;

        sessionStorage.setItem(sessionStorageKey, session);
        setText(localAuthStatus, "Browser session captured");
        url.searchParams.delete("session");
        window.history.replaceState({}, "", url.toString());
      };

      populateTimeSelects();
      bindApiForms();
      captureLocalSession();
      loadSession();
    </script>
  </body>
</html>
