---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell
  title="Jobs"
  active="jobs"
  heading="Jobs"
  lede="Supervisors can create and update scheduled jobs. Workers can view jobs assigned to them."
>
  <div slot="actions" class="button-row requires-supervisor" data-allowed="false">
    <button class="button" type="submit" form="job-form">Save job</button>
  </div>

  <section class="grid two">
    <section class="card requires-supervisor" data-allowed="false">
      <h2>Job Details</h2>
      <form id="job-form" class="form-grid" data-api-form="jobs">
        <input type="hidden" name="id" data-job-id />
        <div class="field">
          <label for="title">Job name</label>
          <input id="title" name="title" required />
        </div>
        <div class="grid two">
          <div class="field">
            <label for="job-customer-name">Customer name</label>
            <input id="job-customer-name" name="customer_name" />
          </div>
          <div class="field">
            <label for="job-customer-email">Customer email</label>
            <input id="job-customer-email" name="customer_email" type="email" />
          </div>
        </div>
        <div class="field">
          <label for="location">Location</label>
          <input id="location" name="location" />
        </div>
        <div class="grid two">
          <div class="field">
            <label for="job-date">Date</label>
            <input id="job-date" name="job_date" type="date" />
          </div>
          <div class="field">
            <label for="start-time">Start time</label>
            <div class="time-row">
              <select id="start-time" name="start_hour" data-hour-select></select>
              <select name="start_minute" data-minute-select></select>
              <select name="start_period" data-period-select></select>
            </div>
          </div>
        </div>
        <div class="grid two">
          <div class="field">
            <label for="end-date">End date</label>
            <input id="end-date" name="end_date" type="date" />
          </div>
          <div class="field">
            <label for="end-time">End time</label>
            <div class="time-row">
              <select id="end-time" name="end_hour" data-hour-select></select>
              <select name="end_minute" data-minute-select></select>
              <select name="end_period" data-period-select></select>
            </div>
          </div>
        </div>
        <div class="field">
          <label for="assigned-workers">Assigned workers</label>
          <select id="assigned-workers" name="assigned_user_ids" data-workers-select multiple size="6"></select>
        </div>
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="scheduled">scheduled</option>
            <option value="draft">draft</option>
            <option value="complete">complete</option>
            <option value="cancelled">cancelled</option>
          </select>
        </div>
        <div class="field">
          <label for="notes">Public notes</label>
          <textarea id="notes" name="public_notes"></textarea>
        </div>
        <div class="field">
          <label for="internal-notes">Internal notes</label>
          <textarea id="internal-notes" name="internal_notes"></textarea>
        </div>
        <button class="button" type="submit">Save job</button>
        <p class="form-status" data-form-status></p>
      </form>
    </section>

    <section class="card">
      <h2>Jobs</h2>
      <div class="empty-state" data-jobs-list>
        Loading jobs from D1.
      </div>
    </section>
  </section>

  <section class="card requires-supervisor" data-allowed="false" data-completion-panel hidden style="margin-top: 18px;">
    <div class="completion-header">
      <div>
        <h2>Work Completion Document</h2>
        <p class="item-meta">Prepare the customer and work details here, then open a clean customer signature document.</p>
      </div>
      <span class="badge warn" data-completion-state>Unsigned</span>
    </div>

    <div class="completion-layout">
      <article class="completion-document" data-completion-preview>
        Select a job to prepare its completion document.
      </article>

      <form id="completion-form" class="form-grid" data-completion-form>
        <div class="grid two">
          <div class="field">
            <label for="customer-name">Customer name</label>
            <input id="customer-name" name="customer_name" required />
          </div>
          <div class="field">
            <label for="customer-email">Customer email</label>
            <input id="customer-email" name="customer_email" type="email" />
          </div>
        </div>
        <div class="field">
          <label for="work-performed">Work performed</label>
          <textarea id="work-performed" name="work_performed"></textarea>
        </div>
        <div class="field">
          <label for="materials-used">Materials used</label>
          <textarea id="materials-used" name="materials_used"></textarea>
        </div>
        <div class="field">
          <label for="customer-notes">Customer notes</label>
          <textarea id="customer-notes" name="customer_notes"></textarea>
        </div>
        <div class="field">
          <label for="work-image">Work image</label>
          <input id="work-image" name="work_image_file" type="file" accept="image/png,image/jpeg,image/webp" data-work-image-input />
          <p class="item-meta">Optional small photo of the completed work.</p>
        </div>
        <div class="button-row">
          <button class="button" type="button" data-open-signature-document>Open customer signature document</button>
        </div>
        <p class="form-status" data-form-status></p>
      </form>
    </div>
  </section>

  <dialog class="signature-dialog" data-signature-dialog>
    <div class="signature-dialog-shell">
      <div class="signature-dialog-bar">
        <div>
          <p class="eyebrow">Customer signature</p>
          <h2>Work Completion Document</h2>
        </div>
        <button class="button secondary" type="button" data-close-signature-document>Close</button>
      </div>

      <article class="completion-document formal-document" data-signature-document-preview>
        Select a job to prepare its completion document.
      </article>

      <section class="signature-block">
        <div>
          <span class="document-label">Customer signature</span>
          <p class="item-meta">By signing, the customer acknowledges the work described above has been completed.</p>
        </div>
        <canvas id="signature-pad" class="signature-pad" width="920" height="240" data-signature-pad></canvas>
        <div class="button-row">
          <button class="button secondary" type="button" data-clear-signature>Clear signature</button>
          <button class="button" type="button" data-submit-signature-document>Sign and complete job</button>
        </div>
      </section>
    </div>
  </dialog>

  <section class="card requires-supervisor" data-allowed="false" style="margin-top: 18px;">
    <h2>Website Consultations</h2>
    <div class="empty-state" data-consultations-list>
      Loading consultation requests from CONSULT_DB.
    </div>
  </section>
</AppShell>
