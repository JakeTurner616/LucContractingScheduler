---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell
  title="Dashboard"
  active="dashboard"
  heading="Dashboard"
  lede="The day at a glance: upcoming jobs, assigned workers, and customer requests."
>
  <div slot="actions" class="button-row requires-supervisor" data-allowed="false">
    <a class="button" href="/jobs">Create job</a>
    <a class="button secondary" href="/feeds">Manage feeds</a>
  </div>

  <section class="role-panel" data-panel-role="supervisor" data-visible="false">
    <div class="grid two">
      <section class="card">
        <h2>Upcoming Jobs</h2>
        <div class="empty-state" data-jobs-list>
          Loading jobs from D1.
        </div>
      </section>

      <section class="card">
        <h2>Website Consultations</h2>
        <div class="empty-state" data-consultations-list>
          Loading consultation requests from CONSULT_DB.
        </div>
      </section>
    </div>
  </section>

  <section class="role-panel" data-panel-role="employee" data-visible="true">
    <div class="grid two">
      <section class="card">
        <p class="eyebrow">Assigned jobs</p>
        <h2>Your Upcoming Jobs</h2>
        <div class="empty-state" data-jobs-list>
          Loading your assigned jobs from D1.
        </div>
      </section>
      <section class="card">
        <p class="eyebrow">Calendar</p>
        <h2>Subscription feed</h2>
        <p class="lede">Your worker ICS feed is available on the Feeds page after a supervisor generates it.</p>
      </section>
    </div>
  </section>
</AppShell>
