---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell
  title="Schedule"
  active="schedule"
  heading="Schedule"
  lede="Calendar view of scheduled jobs. Workers only see jobs assigned to them."
>
  <div slot="actions" class="button-row">
    <button class="button secondary" type="button" data-calendar-toggle>Expand calendar</button>
  </div>

  <section class="card">
    <h2>Job Calendar</h2>
    <div class="empty-state" data-calendar>
      Loading scheduled jobs from D1.
    </div>
  </section>
</AppShell>
