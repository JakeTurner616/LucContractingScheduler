---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell
  title="Settings"
  active="settings"
  heading="Settings"
  lede="Control calendar feed availability and notification defaults for official reminders."
>
  <section class="grid two">
    <section class="card">
      <h2>Calendar Feeds</h2>
      <div class="list">
        <article class="list-item">
          <div>
            <div class="item-title">Read-only ICS feeds</div>
            <p class="item-meta">Employee schedule links are generated by the Worker.</p>
          </div>
          <span class="badge good">Enabled</span>
        </article>
        <article class="list-item">
          <div>
            <div class="item-title">Feed rotation</div>
            <p class="item-meta">Rotate an employee feed when a link has been shared too broadly.</p>
          </div>
          <button class="button secondary" type="button">Rotate</button>
        </article>
      </div>
    </section>

    <section class="card">
      <h2>Notifications</h2>
      <form class="form-grid">
        <div class="field">
          <label for="reminder-window">Reminder window</label>
          <select id="reminder-window" name="reminder-window">
            <option>Evening before shift</option>
            <option>Morning of shift</option>
            <option>Both</option>
          </select>
        </div>
        <div class="field">
          <label for="sender">Sender email</label>
          <input id="sender" name="sender" value="scheduler@luccontracting.com" />
        </div>
        <button class="button" type="button">Save settings</button>
      </form>
    </section>
  </section>
</AppShell>
