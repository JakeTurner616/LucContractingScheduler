---
import AppShell from "../layouts/AppShell.astro";
---

<AppShell
  title="Settings"
  active="settings"
  heading="Settings"
  lede="Session controls."
>
  <section class="grid two">
    <section class="card">
      <h2>Session</h2>
      <div class="list">
        <article class="list-item">
          <div>
            <div class="item-title">Sign out</div>
            <p class="item-meta">End this session on the current device.</p>
          </div>
          <form data-logout-form>
            <button class="button secondary" type="submit">Sign out</button>
          </form>
        </article>
      </div>
    </section>
  </section>
</AppShell>
